VITE_USE_API=false
VITE_API_URL=http://localhost:3001/api
# Required for API mode: strong random secret (min 32 chars)
JWT_SECRET=
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Optional: Google Calendar API key for per-event colors
# https://console.cloud.google.com/apis/credentials (enable Calendar API)
VITE_GCAL_API_KEY=
# Google OAuth 2.0 — required for calendar event CRUD
# https://console.cloud.google.com/apis/credentials (create OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/gcal/auth/callback
# Frontend URL for OAuth callback redirect
FRONTEND_URL=http://localhost:5173
