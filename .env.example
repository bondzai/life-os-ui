# Runtime configuration for the Rust backend (`core/` → lyra-api).
# Copy to .env.local (gitignored) and fill in. The names match wallet-portfolio's, because the
# port reads the same variables — a migrated .env.local works unchanged.

# --- front end (Vite, build-time) ---
# false = local-only storage; true = talk to the API above.
VITE_USE_API=false
# A full URL or just a path ("/api" behind the Docker/nginx proxy). See src/lib/api-url.ts.
VITE_API_URL=http://localhost:3001/api
# Optional: Google Calendar API key for per-event colors.
# https://console.cloud.google.com/apis/credentials (enable Calendar API)
VITE_GCAL_API_KEY=

# --- required ---
# Fatal if missing: the API refuses to start rather than sign tokens with a default.
JWT_SECRET=

# --- server ---
PORT=3001
# Comma-separated. The Vite dev server is HTTPS on 5174, which the http:// defaults do not cover.
CORS_ORIGINS=http://localhost:5173,https://localhost:5174
LYRA_DB=data/lyra.db
# Absolute path to the git-backed knowledge repo. Defaults to ../lyra-knowledge, matching the
# Hono API it replaced.
LYRA_KNOWLEDGE_PATH=

# --- wealth: watched wallets ---
# Comma- or space-separated EVM addresses. Drives the portfolio endpoints, the alert sweep and
# the net-worth snapshot series.
ALERT_WALLETS=

# --- wealth: KuCoin (read-only key; never returned to a client or the model) ---
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=

# --- alerts ---
# Both required for any Telegram delivery. WARNING: with these set, the alert loop sends real
# messages from the second sweep onward (the first baselines silently).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Seconds between sweeps (default 900, floor enforced in config.rs).
ALERT_INTERVAL=
# Hour 0-23 for the daily brief. Unset disables it entirely.
DIGEST_HOUR=
# Net-worth snapshot cadence in seconds (default 3600, floor 300) and its series name.
SNAPSHOT_INTERVAL=
SNAPSHOT_GROUP=server

# --- google calendar (optional, server side) ---
# Required for calendar event CRUD.
# https://console.cloud.google.com/apis/credentials (create OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/gcal/auth/callback
GCAL_API_KEY=
# Where the OAuth callback redirects the browser back to.
FRONTEND_URL=
