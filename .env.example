VITE_USE_API=false
VITE_API_URL=http://localhost:3001/api
# Required for API mode: strong random secret (min 32 chars)
JWT_SECRET=
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Optional: Google Calendar API key for per-event colors
