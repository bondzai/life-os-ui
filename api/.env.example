# Required
JWT_SECRET=your-secret-here-generate-with-openssl-rand-hex-32

# Turso Database (leave empty for local SQLite file)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Your Render frontend URL (for CORS and OAuth redirect)
CORS_ORIGINS=https://lyra.onrender.com,http://localhost:5173
FRONTEND_URL=https://lyra.onrender.com

# Port (default 3001)
PORT=3001

# Seed PINs (default: JB=1234, Sunny=5678)
SEED_PIN_ADMIN=
SEED_PIN_MEMBER=

# Google Calendar OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-api-url/api/gcal/auth/callback
